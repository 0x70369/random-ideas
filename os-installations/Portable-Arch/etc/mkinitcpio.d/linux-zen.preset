# mkinitcpio preset for linux-zen: a UKI for systemd-boot and, in the same run,
# the initramfs image that GRUB boots. No fallback.
## https://wiki.archlinux.org/title/Unified_kernel_image#.preset_file

ALL_kver="/boot/vmlinuz-linux-zen"

PRESETS=('default')

default_image="/boot/initramfs-linux-zen.img"
default_uki="/boot/EFI/Linux/arch-linux-zen.efi"
default_options="--splash /usr/share/systemd/bootctl/splash-arch.bmp"
