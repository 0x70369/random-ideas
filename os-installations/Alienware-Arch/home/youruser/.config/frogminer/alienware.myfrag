# alienware.myfrag: linux-tkg's fixed fragment for the Alienware m16 R1
#
# Base: linux-tkg-config/7.2/config.x86_64 (= Arch's `linux` configuration), after modprobed-db's
# `make localmodconfig`. Applied by merge_config.sh -m, then olddefconfig.
# Validated against the 7.2.15 Kconfig: every line below ends up with the requested value.
#
# The "(§N)" references point to the laptop's inventory document.
# Don't rename: _diffconfig writes to menuconfig-diff.txt, which doesn't end in .myfrag.
#
# localmodconfig only turns off m options with no module in the database. This fragment handles the rest:
# 1. turns back on the debug info that _STRIP="true" turns off;
# 2. turns off what covers absent hardware or the guest role (y options localmodconfig doesn't touch);
# 3. turns into m what doesn't need to be built in;
# 4. reinforces as m the already declared rarely used modules, in case the database lacks them.

# =====================================================================================
# 1. Debug (§31, §33.6)
# =====================================================================================

# _STRIP="true" turns on DEBUG_INFO_NONE, which would turn BTF off. systemd's BPF LSM requires BTF.
# DWARF is used to generate BTF; INSTALL_MOD_STRIP=1 strips it from the installed modules and keeps the .BTF section.
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_DEBUG_INFO_COMPRESSED_ZSTD=y

# Tests, fault injection and developer-only debugging (§33.4, §33.6: "test/mock/simulator/fault-injection/developer-only out").
# What §33.6 says to keep (IKCONFIG, KALLSYMS_ALL, DYNAMIC_DEBUG, ftrace, kprobes,
# uprobes, perf, BPF_EVENTS, debugfs, pstore, MAGIC_SYSRQ) isn't touched here.
# CONFIG_X86_DECODER_SELFTEST is not set
# CONFIG_DEBUG_RODATA_TEST is not set
# CONFIG_DEBUG_SHIRQ is not set
# CONFIG_RUNTIME_TESTING_MENU is not set
# CONFIG_FUNCTION_ERROR_INJECTION is not set
# CONFIG_BLK_ERROR_INJECTION is not set
# Kconfig: "If you are not helping to develop drivers, say N".
# CONFIG_MMIOTRACE is not set
# Debugging over a USB 3 port with a debug cable and a second computer. Kconfig: "If unsure, say 'N'".
# CONFIG_USB_XHCI_DBGCAP is not set
# CONFIG_EARLY_PRINTK_USB_XDBC is not set
# Early printk through the EHCI debug port: there is no EHCI controller. Kconfig: "You should normally say N here".
# CONFIG_EARLY_PRINTK_DBGP is not set
# OVMF firmware log: only exists inside a VM.
# CONFIG_OVMF_DEBUG_LOG is not set

# EFI pstore (§8): Arch's configuration turns the EFI backend off by default (pstore_disable=Y on zen,
# checked on 2026-11-09), so no crash was saved. The Kconfig default is on. Each crash writes
# a few KB to NVRAM. systemd-pstore.service moves the records to /var/lib/systemd/pstore and erases them
# from NVRAM on the next boot; it must be enabled (systemctl enable systemd-pstore.service).
# CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE is not set

# kexec and kdump: crash diagnosis uses pstore (§8), and kdump isn't set up.
# With lockdown at "none" (§18), kexec_load lets root boot an unsigned kernel
# without going through Secure Boot (§33.5: reduce the attack surface).
# To use `systemctl kexec` or kdump, turn KEXEC_FILE back on with KEXEC_SIG.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# Kexec HandOver and Live Update (updating servers' kernels through kexec without losing the VMs);
# KEXEC_HANDOVER selects KEXEC_FILE
# CONFIG_KEXEC_HANDOVER is not set
# CONFIG_LIVEUPDATE is not set
# PE file signature verification: only kexec used it
# CONFIG_SIGNED_PE_FILE_VERIFICATION is not set

# =====================================================================================
# 2. CPU, platform and host role (§2, §16, §33.7, §33.8)
# =====================================================================================

# Intel CPUs only (i9-13900HX). Support for other CPUs only goes away with EXPERT (block 8).
# CONFIG_AMD_IOMMU is not set
# CONFIG_IOMMU_PT_AMDV1 is not set
# CONFIG_AMD_3D_VCACHE is not set
# CONFIG_AMD_MEM_ENCRYPT is not set
# CONFIG_X86_AMD_PLATFORM_DEVICE is not set
# CONFIG_AMD_WBRF is not set
# CONFIG_PINCTRL_AMD is not set
# CONFIG_USB_PCI_AMD is not set
# CONFIG_SND_SOC_SOF_AMD_TOPLEVEL is not set
# CONFIG_SND_AMD_ACP_CONFIG is not set
# CONFIG_X86_MCE_AMD is not set
# CONFIG_AMD_NUMA is not set
# CONFIG_PERF_EVENTS_AMD_BRS is not set
# CONFIG_AMD_HFI is not set
# CONFIG_CRYPTO_DEV_CCP is not set
# Mitigations for flaws that only exist on AMD CPUs (all "depends on CPU_SUP_AMD"): retbleed=unret/ibpb,
# SRSO and TSA. The Intel and common mitigations all stay.
# CONFIG_MITIGATION_UNRET_ENTRY is not set
# CONFIG_MITIGATION_IBPB_ENTRY is not set
# CONFIG_MITIGATION_SRSO is not set
# CONFIG_MITIGATION_TSA is not set

# Features the processor doesn't have: TDX is Xeon only, and the sgx flag doesn't show up (checked on 2026-11-09)
# CONFIG_INTEL_TDX_HOST is not set
# CONFIG_X86_SGX is not set
# Turbo Boost Max 3.0: Kconfig "only required when the system is not using Hardware P-States (HWP)";
# here intel_pstate is in active mode with HWP (§32A)
# CONFIG_INTEL_TURBO_MAX_3 is not set
# MPS table: Kconfig "For old smp systems that do not have proper acpi support"
# CONFIG_X86_MPPARSE is not set

# RDT/resctrl (CAT, CMT, MBA): the CPU doesn't have the rdt_a, cat_l2/l3, cqm and mba flags (checked on 2026-11-09)
# CONFIG_X86_CPU_RESCTRL is not set

# Old/embedded Intel platforms: Merrifield (SCU), Bay Trail/Cherry Trail (Crystal Cove and
# Whiskey Cove PMICs, pinctrl, I2C semaphore), notebooks with 32-bit UEFI
# CONFIG_INTEL_SCU_PCI is not set
# CONFIG_INTEL_SOC_PMIC is not set
# CONFIG_INTEL_SOC_PMIC_CHTWC is not set
# CONFIG_PINCTRL_BAYTRAIL is not set
# CONFIG_PINCTRL_CHERRYVIEW is not set
# CONFIG_I2C_DESIGNWARE_BAYTRAIL is not set
# CONFIG_EFI_MIXED is not set
# EFI handover protocol (DEPRECATED): only old bootloaders and patched GRUB use it. The UKI enters
# through the EFI stub's normal PE entry point, and the initrd comes through LoadFile2.
# CONFIG_EFI_HANDOVER_PROTOCOL is not set
# RCI2 table (Dell PowerEdge servers), confidential computing secrets and heaps (guest)
# CONFIG_EFI_RCI2_TABLE is not set
# CONFIG_EFI_COCO_SECRET is not set
# CONFIG_DMABUF_HEAPS_SYSTEM_CC_SHARED is not set

# Other vendors' platforms (§33.7: "ChromeOS EC isn't needed just because the laptop has an EC")
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_GOOGLE_FIRMWARE is not set
# CONFIG_SURFACE_PLATFORMS is not set
# CONFIG_MELLANOX_PLATFORM is not set
# CONFIG_X86_PLATFORM_DRIVERS_HP is not set
# CONFIG_X86_PLATFORM_DRIVERS_UNIWILL is not set

# Guest: this kernel never runs inside a VM (§0, §16, §33.8).
# HYPERVISOR_GUEST takes PARAVIRT, KVM_GUEST, Xen, Jailhouse, ACRN and the TDX guest with it.
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_HYPERV is not set
# CONFIG_VMGENID is not set
# CONFIG_PVPANIC is not set
# CONFIG_VIRT_DRIVERS is not set
# CONFIG_MOUSE_PS2_VMMOUSE is not set
# VirtIO frontends (the VM's virtio devices are served by the host's vhost_net, which stays)
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_SCSI_VIRTIO is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_FS is not set
# CONFIG_VIRTIO_MENU is not set
# Auxiliary processors of ARM SoCs; selects the VirtIO core
# CONFIG_REMOTEPROC is not set

# Host KVM: Intel only, no TDX and no Xen emulation for guests (§16: "doesn't use Xen").
# KVM_HYPERV stays: these are the Hyper-V enlightenments the Windows VMs use.
# CONFIG_KVM_AMD is not set
# CONFIG_KVM_INTEL_TDX is not set
# CONFIG_KVM_XEN is not set

# IOMMU on by default (§1B, §31): makes intel_iommu=on unnecessary.
# The parameter can stay in cmdline.d with no side effect.
CONFIG_INTEL_IOMMU_DEFAULT_ON=y

# x32 ABI: no Arch program uses it; it's exposed syscall code with no use (§33.5).
# IA32 (32-bit, Steam/Wine) stays.
# CONFIG_X86_X32_ABI is not set

# /dev/mem and /dev/port: raw access to physical memory and I/O ports (§33.5). The only user would be
# intel-undervolt, for MMIO power limits and Tjunction, but its configuration only has undervolt
# (through msr), and the power limits come from tuned through powercap (checked on 2026-11-10). If
# intel-undervolt's "power" or "tjoffset" lines are ever used, turn DEVMEM back on.
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# /dev/snapshot (uswsusp). Kconfig: "Say N if no snapshotting from userspace is needed, this also reduces
# the attack surface of the kernel". systemd hibernates through /sys/power/state.
# CONFIG_HIBERNATION_SNAPSHOT_DEV is not set

# ioperm()/iopl(): Kconfig "necessary for legacy applications"; raw access to every I/O
# port (§33.5: avoid raw access). Nothing declared in the inventory uses it.
# CONFIG_X86_IOPL_IOPERM is not set

# MSR and CPUID as modules. msr doesn't load by itself when /dev/cpu/*/msr is opened, but intel-undervolt
# (§32) runs "/sbin/modprobe msr" before opening it.
CONFIG_X86_MSR=m
CONFIG_X86_CPUID=m

# Hibernation with lz4 by default (§1B, §8). Makes hibernate.compressor=lz4 unnecessary.
# zswap already defaults to zstd and CRYPTO_ZSTD is already y in the base, so the compressor is available
# at zswap's initcall (§33.3).
CONFIG_HIBERNATION_COMP_LZ4=y

# =====================================================================================
# 3. Disable: modules loaded only because of the configuration (§2 "Disable")
# =====================================================================================

# The internal Bluetooth is Intel (btintel)
# CONFIG_BT_HCIBTUSB_RTL is not set
# CONFIG_BT_HCIBTUSB_BCM is not set
# CONFIG_BT_HCIBTUSB_MTK is not set
# Raptor Lake iGPU on i915; dGPU on nvidia-open-dkms
# WARNING: DRM_XE (through DRM_GPUSVM) is the only option that selects HMM_MIRROR in this configuration, and
# HMM_MIRROR has no prompt of its own in the Kconfig. Without it, nvidia-uvm builds without HMM (CUDA
# can no longer access memory allocated with plain malloc; cudaMalloc and managed memory keep working).
# NVENC/NVDEC, Vulkan, NVML and PRIME don't use HMM. To keep HMM, replace the line below with
# CONFIG_DRM_XE=m (xe builds, but doesn't bind to the Raptor Lake iGPU without force_probe).
# CONFIG_DRM_XE is not set
# CONFIG_DRM_NOUVEAU is not set
# Audio through SOF, no SoundWire device. Nothing that stays on selects SOUNDWIRE: the
# soundwire_intel/_cadence controllers (in modprobed.db) and soundwire_amd go too. SOF, HDA and SDCA stay.
# CONFIG_SND_SOC_INTEL_AVS is not set
# CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE is not set
# CONFIG_SOUNDWIRE is not set

# =====================================================================================
# 4. Absent hardware (§0, §33.1, §33.7)
# =====================================================================================

# No SATA/AHCI controller on PCI (NVMe only). External SATA disks use usb-storage/uas.
# CONFIG_ATA is not set
# NVMe: a single-port SSD, no NVMe over Fabrics. Without Fabrics authentication, the nvme_auth and
# nvme_keyring modules (in modprobed.db only as a dependency) no longer exist.
# CONFIG_NVME_MULTIPATH is not set
# CONFIG_NVME_HOST_AUTH is not set
# DAX core: no persistent memory or CXL, and FS_DAX goes below
# CONFIG_DAX is not set
# No zoned disks (host-managed SMR/ZNS), no NVDIMM/CXL (DAX, HMAT), no ACPI dock (the docks are
# Thunderbolt), no memory hot-swap, no HBAs or SAN
# CONFIG_BLK_DEV_ZONED is not set
# CONFIG_FS_DAX is not set
# CONFIG_ACPI_HMAT is not set
# CONFIG_ACPI_DOCK is not set
# CONFIG_ACPI_HOTPLUG_MEMORY is not set
# CONFIG_FUSION is not set
# CONFIG_SCSI_DH is not set
# CONFIG_NET_FC is not set
# PCI: no SR-IOV, TSM, drive bay LEDs (NPEM), CompactPCI, SHPC (PCI-X) or DesignWare controller.
# PCIe and ACPI hotplug stay, which Thunderbolt uses, and so does P2PDMA, which VFIO_PCI_DMABUF depends on.
# CONFIG_PCI_IOV is not set
# CONFIG_PCI_TSM is not set
# CONFIG_PCI_NPEM is not set
# CONFIG_HOTPLUG_PCI_CPCI is not set
# CONFIG_HOTPLUG_PCI_SHPC is not set
# CONFIG_PCIE_DW_PLAT_HOST is not set
# Compute accelerators (NPU, Habana): Intel's NPU starts with Meteor Lake
# CONFIG_DRM_ACCEL is not set
# No AGP; i915 uses INTEL_GTT, which it selects itself
# CONFIG_AGP is not set
# UEFI-only boot: no legacy BIOS VESA (simpledrm and efifb stay, §18, §33.3)
# CONFIG_FB_VESA is not set
# No EHCI/OHCI/UHCI controllers: xHCI only (PCH and Thunderbolt)
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_UHCI_HCD is not set
# DesignWare DMA (LPSS uses idma64) and DesignWare I2C PCI (§26: LPSS uses DesignWare platform)
# CONFIG_DW_DMAC_PCI is not set
# CONFIG_I2C_DESIGNWARE_PCI is not set
# ACPI_FAN stays as m: there is no ACPI fan (PNP0C0B/INTC1048 absent), but INT340X_THERMAL
# (DPTF, in use, §22) selects it. The fan module only loads if the device exists.
CONFIG_ACPI_FAN=m
# No UART serial port at all: the 8250 driver only registers the 32 empty ports, with no "ttySN is a
# 16550A" in dmesg and no PNP0501 device (checked on 2026-11-09). The bound "serial8250" from §2 is the
# platform device the driver itself creates. The USB serial adapters (§13) don't depend on it.
# CONFIG_SERIAL_8250 is not set
# CONFIG_SERIAL_NONSTANDARD is not set
# SPI target mode (the PC is the controller)
# CONFIG_SPI_SLAVE is not set
# serdev bus: devices attached to internal UARTs (SoCs' UART Bluetooth); the Bluetooth here is USB
# CONFIG_SERIAL_DEV_BUS is not set
# I2C target mode
# CONFIG_I2C_SLAVE is not set
# Bluetooth over PCIe (Lunar Lake onward): the Bluetooth here is USB
# CONFIG_BT_INTEL_PCIE is not set
# USB audio offload through xHCI (Qualcomm platforms)
# CONFIG_USB_XHCI_SIDEBAND is not set
# SoC infrastructure with no user here: devfreq, HTE, hwspinlock, interconnect, memory controllers,
# multiplexers, board reset, Lightning Mountain DMA, RAID offload, PoE, VCAP
# CONFIG_PM_DEVFREQ is not set
# CONFIG_HTE is not set
# CONFIG_HWSPINLOCK is not set
# CONFIG_INTERCONNECT is not set
# CONFIG_MEMORY is not set
# CONFIG_MUX_CORE is not set
# CONFIG_POWER_RESET is not set
# CONFIG_INTEL_LDMA is not set
# CONFIG_ASYNC_TX_DMA is not set
# CONFIG_PSE_CONTROLLER is not set
# CONFIG_VCAP is not set
# Server RAS features (scrub, ECS and memory repair through CXL/ACPI RAS2)
# CONFIG_EDAC_SCRUB is not set
# CONFIG_EDAC_ECS is not set
# CONFIG_EDAC_MEM_REPAIR is not set
# PMIC OpRegion (Bay Trail/Cherry Trail)
# CONFIG_PMIC_OPREGION is not set
# Embedded boards' PMICs, built in as bool (§29: "PMIC drivers aren't needed just because there is a battery")
# CONFIG_MFD_88PM860X is not set
# CONFIG_MFD_AAT2870_CORE is not set
# CONFIG_MFD_AS3711 is not set
# CONFIG_MFD_DA9052_I2C is not set
# CONFIG_MFD_DA9052_SPI is not set
# CONFIG_MFD_DA9055 is not set
# CONFIG_MFD_LP8788 is not set
# CONFIG_MFD_MAX77843 is not set
# CONFIG_MFD_MAX8925 is not set
# CONFIG_MFD_MAX8997 is not set
# CONFIG_MFD_MAX8998 is not set
# CONFIG_MFD_RC5T583 is not set
# CONFIG_MFD_TPS65090 is not set
# CONFIG_MFD_TPS6586X is not set
# CONFIG_MFD_TPS65910 is not set
# CONFIG_MFD_TWL4030_AUDIO is not set
# CONFIG_MFD_WM831X_I2C is not set
# CONFIG_MFD_WM831X_SPI is not set
# CONFIG_MFD_WM8350_I2C is not set
# CONFIG_MFD_WM8400 is not set
# CONFIG_PMIC_ADP5520 is not set
# CONFIG_PMIC_DA903X is not set
# CONFIG_TWL4030_CORE is not set
# CONFIG_TWL6040_CORE is not set
# CONFIG_PINCTRL_SX150X is not set
# Touchscreen and graphics tablet: there are none
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_TABLET is not set
# Other vendors' PS/2 touchpad extensions that show up without EXPERT (the rest are in block 8)
# CONFIG_MOUSE_PS2_ELANTECH is not set
# CONFIG_MOUSE_PS2_SENTELIC is not set
# CONFIG_MOUSE_PS2_TOUCHKIT is not set
# Analog and digital TV, radio, platform cameras (MIPI/IPU absent, §2), PCI capture cards
# and media test drivers. USB camera and media stay (UVC webcam, §10).
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_PLATFORM_SUPPORT is not set
# CONFIG_MEDIA_PCI_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_VIDEO_CAMERA_SENSOR is not set
# CONFIG_VIDEO_CAMERA_LENS is not set
# CONFIG_STAGING is not set
# Infrared remote control (§12: "LIRC/IR deemed unnecessary"), including remote control
# key passthrough over HDMI-CEC. i915's CEC (DP/HDMI) stays.
# CONFIG_LIRC is not set
# CONFIG_MEDIA_CEC_RC is not set
# CONFIG_RC_CORE is not set
# NAND flash: the only flash is the firmware's SPI NOR (§27)
# CONFIG_MTD_NAND_ECC_SW_HAMMING is not set
# CONFIG_MTD_NAND_ECC_SW_BCH is not set
# CONFIG_MTD_NAND_ECC_MXIC is not set
# eMMC (RPMB): the reader is for SD cards (§9)
# CONFIG_RPMB is not set
# Specific USB audio interfaces (Edirol UA-101, Tascam US-122/224/428): not in modprobed.db
# CONFIG_SND_USB_UA101 is not set
# CONFIG_SND_USB_USX2Y is not set
# CONFIG_SND_USB_US122L is not set
# Logitech G940 joystick (the Logitech gamepads stay, §12)
# CONFIG_LOGIG940_FF is not set
# ECC memory hardware: the modules aren't ECC (§3)
# CONFIG_EDAC_IE31200 is not set
# AlienFX through legacy WMI: GUID A90597CE doesn't exist in this firmware (only WMAX, A70591CE)
# CONFIG_ALIENWARE_WMI_LEGACY is not set
# USB networking: the declared devices (RPi, Android, iPhone, AX88179, RTL8152) use
# CDC ECM/NCM, RNDIS, ipheth, ax88179_178a and r8152. cdc_subset is for old adapters.
# CONFIG_USB_NET_CDC_SUBSET is not set

# =====================================================================================
# 5. Security and unused interfaces (§33.5, the sections' decisions)
# =====================================================================================

# LSMs built that aren't on the active list (§18: landlock, lockdown, yama, integrity, bpf). AppArmor and
# SELinux stay by §31's decision; these weren't decided there and have no use.
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_LOADPIN is not set
# CONFIG_SECURITY_SAFESETID is not set
# CONFIG_SECURITY_IPE is not set
# Initramfs decompressors: the UKI uses zstd (§8, COMPRESSION="zstd"). Turn the chosen format's back on if
# mkinitcpio changes compression.
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# Partition tables: GPT and MBR stay. The rest are parsers of data from any connected media.
# CONFIG_AIX_PARTITION is not set
# CONFIG_MAC_PARTITION is not set
# CONFIG_BSD_DISKLABEL is not set
# CONFIG_MINIX_SUBPARTITION is not set
# CONFIG_SOLARIS_X86_PARTITION is not set
# CONFIG_LDM_PARTITION is not set
# CONFIG_KARMA_PARTITION is not set
# New NTFS driver (fs/ntfs, since 7.1), the user's choice in the 1st build's menuconfig (2026-11-11): faster
# than ntfs3 at writing and mounting, being tested to become the default (§8). Without NTFS_DEBUG (2026-11-13): it only
# serves to debug the driver itself (internal messages and checks, for bug reports); validation of what
# comes from the disk and the warnings about volumes with errors work without it.
CONFIG_NTFS_FS=m
# CONFIG_NTFS_DEBUG is not set
# BSD process accounting (DEPRECATED) and the cgroups RDMA controller
# CONFIG_BSD_PROCESS_ACCT is not set
# CONFIG_CGROUP_RDMA is not set
# Datacenter, BMC and router networking: DCB, MCTP, NC-SI, MPLS, PSP, switchdev, netkit, IPv6
# routing headers (SRv6, RPL, IOAM), bridge ring protocols (MRP, CFM)
# CONFIG_DCB is not set
# CONFIG_MCTP is not set
# CONFIG_NET_NCSI is not set
# CONFIG_MPLS is not set
# CONFIG_INET_PSP is not set
# CONFIG_NET_SWITCHDEV is not set
# CONFIG_NETKIT is not set
# CONFIG_IPV6_SEG6_LWTUNNEL is not set
# CONFIG_IPV6_RPL_LWTUNNEL is not set
# CONFIG_IPV6_IOAM6_LWTUNNEL is not set
# CONFIG_BRIDGE_MRP is not set
# CONFIG_BRIDGE_CFM is not set
# macvlan/macvtap: libvirt uses bridge and tun (§16). localmodconfig kept them because of the tap module,
# which only loaded as a dependency of vhost_net.
# CONFIG_MACVLAN is not set
# CONFIG_MACVTAP is not set
# TEE trusted keys (OP-TEE, AMD-TEE): only the TPM (§19). The tee module only loaded as a dependency.
# CONFIG_TRUSTED_KEYS_TEE is not set
# CONFIG_TEE is not set
# Console accessibility (braille, speakup)
# CONFIG_ACCESSIBILITY is not set
# TPM: CRB interface (§19). No TIS/FIFO.
# CONFIG_TCG_TIS is not set
# CONFIG_TCG_TIS_CORE is not set
# Legacy /proc/i8k (§23)
# CONFIG_I8K is not set
# SPI flash: spi_intel_pci stays; the platform variant and spidev go (§27)
# CONFIG_SPI_INTEL_PLATFORM is not set
# CONFIG_SPI_SPIDEV is not set
# Watchdog: iTCO only; no pretimeout and no softdog (§20)
# CONFIG_WATCHDOG_PRETIMEOUT_GOV is not set
# CONFIG_SOFT_WATCHDOG is not set
# MEI's iAMT watchdog (§25)
# CONFIG_INTEL_MEI_WDT is not set
# Old PCH thermal and thermal emulation (§22)
# CONFIG_INTEL_PCH_THERMAL is not set
# CONFIG_THERMAL_EMULATION is not set
# OSS emulation: PipeWire uses ALSA (§5)
# CONFIG_SND_OSSEMUL is not set
# /dev/nvram (legacy BIOS CMOS): only thinkpad_acpi selects it; hwclock uses /dev/rtc
# CONFIG_NVRAM is not set

# Hardening (§0: security above performance). Rule: every security lever on, except those the
# Kconfig says to leave at N when in doubt ("If unsure, say N" or equivalent) and those that would break a declared use. The base's protections remain: KERNEL_IBT, shadow stack,
# INIT_STACK_ALL_ZERO, INIT_ON_ALLOC, HARDENED_USERCOPY, FORTIFY_SOURCE, SLAB_FREELIST_*, RANDOMIZE_KSTACK_OFFSET.
#
# Zeroes memory when freeing it, besides when allocating: erased data doesn't linger on the heap. Costs more than
# init_on_alloc (Kconfig: "more expensive [...] due to the negative cache effects"). To measure without
# rebuilding, init_on_free=0 on the command line turns it off.
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
# Zeroes the registers on function exit: less side-channel leakage and about 20% fewer ROP
# gadgets. Kconfig: "less than 1% performance impact on most workloads".
CONFIG_ZERO_CALL_USED_REGS=y
# Separate slab caches: a heap overflow only reaches objects in the same cache. Costs some
# memory fragmentation (equivalent to slab_nomerge).
# CONFIG_SLAB_MERGE_DEFAULT is not set
# /proc/PID/mem never ignores page permissions. gdb still inserts breakpoints through ptrace.
CONFIG_PROC_MEM_NO_FORCE=y
# Several isolated copies of the kmalloc caches: objects from different subsystems don't sit side by side
CONFIG_KMALLOC_PARTITION_CACHES=y
# A module without a valid signature doesn't load (before, it only marked the kernel as tainted). The kernel's modules are
# signed at build time (MODULE_SIG_ALL), and the DKMS ones (nvidia, kvmfr) with the MOK, which the kernel trusts through the
# machine keyring (§18). If DKMS signing fails, nvidia doesn't load: use linux or linux-zen.
CONFIG_MODULE_SIG_FORCE=y
# Lockdown started before the other LSMs. With lockdown forced to "none" (§18: integrity mode prevents
# hibernation), it only has an effect if lockdown is ever turned on.
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# UBSAN out (2026-11-13): without the trap it only warns in dmesg, protecting nothing, and the cost of the checks stays
# across the whole kernel and the DKMS modules; with the trap, harmless behavior would bring down the kernel or nvidia.
# No realistic use as debugging (§33.6).
# CONFIG_UBSAN is not set
# modprobe --force and rmmod -f. Kconfig: "usually a really bad idea" and "If unsure, say N".
# CONFIG_MODULE_FORCE_LOAD is not set
# CONFIG_MODULE_FORCE_UNLOAD is not set
# Old line disciplines (N_HDLC, N_GSM, PPP...) no longer load on an ordinary user's request.
# None is used; root can still load them.
# CONFIG_LDISC_AUTOLOAD is not set
#
# Stay at N because the Kconfig says so: BUG_ON_DATA_CORRUPTION and PANIC_ON_OOPS ("If unsure, say N"),
# PAGE_TABLE_CHECK ("If unsure say n"), STRICT_SIGALTSTACK_SIZE ("Say 'N' unless you want to really enforce"),
# IMA and EVM ("answer N"), plus MODULE_FORCE_UNLOAD and SYSFS_SYSCALL, already off above or in the base.
# CONFIG_BUG_ON_DATA_CORRUPTION is not set
# CONFIG_PANIC_ON_OOPS is not set
# CONFIG_PAGE_TABLE_CHECK is not set
# CONFIG_STRICT_SIGALTSTACK_SIZE is not set
#
# Stay off because they would break declared uses:
# - STATIC_USERMODEHELPER: every call to userspace programs (modprobe for modules loaded
#   on demand, systemd-coredump) would go through a single intermediate binary, which Arch doesn't have
# - LOCK_DOWN_KERNEL_FORCE_INTEGRITY/CONFIDENTIALITY: they prevent hibernation (§18)
# - SECURITY_LOADPIN: only accepts modules and firmware from the first filesystem used, the initramfs
# - MODIFY_LDT_SYSCALL and X86_16BIT (block 8): Wine needs them
# - INTEGRITY_CA_MACHINE_KEYRING: only puts MOKs with CA:TRUE and keyUsage keyCertSign in the machine keyring
#   (restrict_link_by_ca). MOK.crt and MOK-module-signing.crt have CA:TRUE but no keyUsage (checked on
#   2026-11-10): they would go to the platform keyring, which doesn't apply to modules, and with MODULE_SIG_FORCE
#   nvidia and kvmfr would stop loading
#
# Not available with GCC: CFI (GCC 16.2 doesn't accept -fsanitize=kcfi, checked on 2026-11-10),
# KSTACK_ERASE (requires Clang's stack depth callback) and RANDSTRUCT (would break the DKMS modules
# with precompiled objects).

# Debug counters nobody reads, incremented on hot paths (locks and page attribute changes)
# CONFIG_LOCK_EVENT_COUNTS is not set
# CONFIG_X86_CPA_STATISTICS is not set

# =====================================================================================
# 6. Built-in → module (§0, §19, §33.2, §33.3)
# =====================================================================================

# Stay built in: BINFMT_SCRIPT, FW_LOADER, EFI_VARS_PSTORE (crashes from early boot), TCP_CONG_CUBIC (the TCP
# default must be built in; as a module, the kernel falls back to Reno) and EFIVAR_FS (the initramfs's systemd reads the
# HibernateLocation EFI variable to find the hibernation image, with no resume= on the command line). The other built-in ones are selected by
# built-in options and can't change.
#
CONFIG_EFIVAR_FS=y
# Back to y after the 1st build (2026-11-11):
# - DRM, DRM_SIMPLEDRM and FB: display from the start of the kernel (errors and panics before the initramfs show up) and
#   the LUKS prompt without depending on MODULES; i915 and nvidia_drm load the DRM core on every boot anyway
# - ACPI_THERMAL: Kconfig "HIGHLY recommended"; as a module, the firmware's thermal zones only applied after LUKS
# - RTC_DRV_CMOS: correct clock from boot (RTC_HCTOSYS), including in the initramfs's journal
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_ACPI_THERMAL=y
CONFIG_RTC_DRV_CMOS=y
#
# Turned into modules in the 1st build's menuconfig (2026-11-11), by the user's choice. Consequences checked:
# - MQ_IOSCHED_DEADLINE: the kernel doesn't load it by itself; a udev rule requests it for USB disks and SD cards
# - CONNECTOR: PROC_EVENTS (fork/exec/exit events over netlink) requires y and goes away
# - NET_SCH_FQ_CODEL: systemd's net.core.default_qdisc sysctl (50-default.conf) loads it at boot
CONFIG_IKCONFIG=m
CONFIG_IKHEADERS=m
CONFIG_MQ_IOSCHED_DEADLINE=m
CONFIG_PACKET=m
CONFIG_PACKET_DIAG=m
CONFIG_UNIX_DIAG=m
CONFIG_CONNECTOR=m
CONFIG_INPUT_LEDS=m
CONFIG_INPUT_EVDEV=m
CONFIG_SERIO=m
CONFIG_HWMON=m
CONFIG_WATCHDOG_CORE=m
CONFIG_BACKLIGHT_CLASS_DEVICE=m
CONFIG_HID=m
CONFIG_USB=m
CONFIG_LEDS_CLASS=m
CONFIG_EDAC=m
CONFIG_EDAC_GHES=m
CONFIG_UNICODE=m
CONFIG_CRYPTO_DRBG=m
CONFIG_CRYPTO_JITTERENTROPY=m
CONFIG_CRYPTO_PCRYPT=m
CONFIG_CRYPTO_LZ4HC=m
#
# Can be m without changing mkinitcpio (§33.3): autodetect and the hooks already put them in the UKI.
# The NLS core stays y: ACPI and USB, built in, select it. The codepages become modules.
CONFIG_TCG_TPM=m
CONFIG_TCG_CRB=m
CONFIG_BTRFS_FS=m
CONFIG_CRYPTO_XTS=m
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_XHCI_PCI=m
CONFIG_USB_HID=m
CONFIG_HID_GENERIC=m
CONFIG_SERIO_I8042=m
CONFIG_KEYBOARD_ATKBD=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ASCII=m
# Disk: the block hook always includes sd_mod (and scsi_mod comes as a dependency)
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
# LPSS's DesignWare I2C (§26: "can be modular"); the I2C core stays y
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
# Loaded on demand: I/O schedulers when writing to /sys/block/*/queue/scheduler (mq-deadline, which the
# kernel doesn't load by itself, is requested by a udev rule for USB disks and SD cards); generic cpufreq governors (
# intel_pstate in active mode doesn't use them; the kernel loads one when it's chosen in scaling_governor); crypto
# algorithms, through the crypto-* aliases (the sd-encrypt hook puts all of them in the initramfs, §33.3)
CONFIG_IOSCHED_BFQ=m
CONFIG_MQ_IOSCHED_KYBER=m
CONFIG_CPU_FREQ_GOV_POWERSAVE=m
CONFIG_CPU_FREQ_GOV_USERSPACE=m
CONFIG_CPU_FREQ_GOV_ONDEMAND=m
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=m
CONFIG_CRYPTO_AES=m
CONFIG_CRYPTO_CBC=m
CONFIG_CRYPTO_CTR=m
CONFIG_CRYPTO_CTS=m
CONFIG_CRYPTO_ECDH=m
CONFIG_CRYPTO_MD5=m
CONFIG_CRYPTO_SHA1=m
CONFIG_CRYPTO_SHA3=m
CONFIG_CRYPTO_BLAKE2B=m
CONFIG_CRYPTO_XXHASH=m
CONFIG_CRYPTO_CRC32C=m
# No user at boot: the hwrng core (only the TPM, also a module, uses it), dma-buf heaps, extcon, raw DMI tables
# in /sys/firmware/dmi/entries, pci-stub (passthrough uses vfio-pci), drop_monitor (dropwatch)
CONFIG_HW_RANDOM=m
CONFIG_DMABUF_HEAPS_SYSTEM=m
CONFIG_DMABUF_HEAPS_CMA=m
CONFIG_EXTCON=m
CONFIG_DMI_SYSFS=m
CONFIG_PCI_STUB=m
CONFIG_NET_DROP_MONITOR=m
# Loaded by udev, by systemd or on mount; none is used before the initramfs
CONFIG_FUSE_FS=m
CONFIG_AUTOFS_FS=m
CONFIG_CONFIGFS_FS=m
CONFIG_BINFMT_MISC=m
CONFIG_ACPI_AC=m
CONFIG_ACPI_BATTERY=m
CONFIG_ACPI_BUTTON=m
CONFIG_USB_SERIAL=m
# ext4 isn't declared, but it's the filesystem of a Raspberry Pi's card (§13). It stays as
# a module instead of built in.
CONFIG_EXT4_FS=m

# =====================================================================================
# 7. Safety net: already declared rarely used modules (§31)
# =====================================================================================
# If modprobed-db hasn't seen them, localmodconfig turns them off; the fragment turns them back on.
# Requesting m for an option that is already m changes nothing.

# External media and images (§8): exFAT, FAT, ISO 9660 with Joliet/Rock Ridge/zisofs, UDF, loop, nbd, uas
CONFIG_EXFAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_NLS_UTF8=m
CONFIG_NLS_ISO8859_1=m
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_BLK_DEV_NBD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_CHR_DEV_SG=m
# lz4 hibernation (§1B)
CONFIG_CRYPTO_LZ4=y

# USB serial: Arduino/ESP32/RPi (§13)
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m

# USB networking and phones (§6, §13, §14)
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_RTL8152=m
CONFIG_USB_IPHETH=m

# Gamepads and Steam Input (§12)
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
CONFIG_HID_MICROSOFT=m
CONFIG_HID_LOGITECH=m
CONFIG_LOGITECH_FF=y
# Racing wheels: the user doesn't have one yet (§12, 2026-11-10). After buying one, turn the brand's driver back on: for
# Logitech G25/G27/G29/G920, LOGIWHEELS_FF; for those following the USB PID standard, HID_PID.
# CONFIG_LOGIWHEELS_FF is not set
# CONFIG_HID_PID is not set
CONFIG_USB_HIDDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_JOYDEV=m

# The PCH's SMBus: the RAM's SPD5118 and iTCO (§20, §23, §26)
CONFIG_I2C_I801=m

# Logitech HID (§11)
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m

# Bluetooth: HID, audio and networking (§6, §12)
CONFIG_BT_HIDP=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_UHID=m

# USB audio and MIDI (§5)
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_SEQ_HRTIMER_DEFAULT=y

# Virtualization (§16)
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_HYPERV=y
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VHOST_NET=m
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_DM_CRYPT=m
CONFIG_BLK_DEV_DM=m

# VPN (§6)
CONFIG_WIREGUARD=m

# QoS (§6): fq_codel as the default (a module since the 1st build; tkg would switch the default to CAKE), FQ and CAKE as modules
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_FLOWER=m
CONFIG_NET_CLS_MATCHALL=m
CONFIG_NET_ACT_GACT=m
CONFIG_NET_ACT_MIRRED=m

# Games (§17)
CONFIG_NTSYNC=m

# =====================================================================================
# 8. What can only go away with EXPERT
# =====================================================================================
# These options only show up with EXPERT=y. EXPERT only reveals prompts; tested on 7.2.15, turning it on changes
# no other option in this configuration.
#
CONFIG_EXPERT=y
# Support for AMD, Hygon, Centaur (VIA) and Zhaoxin CPUs
CONFIG_PROCESSOR_SELECT=y
# CONFIG_CPU_SUP_AMD is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
# Other vendors' PS/2 protocols for touchpads and trackpoints
# CONFIG_MOUSE_PS2_ALPS is not set
# CONFIG_MOUSE_PS2_BYD is not set
# CONFIG_MOUSE_PS2_CYPRESS is not set
# CONFIG_MOUSE_PS2_FOCALTECH is not set
# CONFIG_MOUSE_PS2_LIFEBOOK is not set
# CONFIG_MOUSE_PS2_LOGIPS2PP is not set
# CONFIG_MOUSE_PS2_TRACKPOINT is not set
# /dev/gpiochipN and the v1 ABI unnecessary (§28)
# CONFIG_GPIO_CDEV is not set
# Legacy interfaces (§33.5): 16-bit UID syscalls and sgetmask/ssetmask (obsolete, libc doesn't use them)
# CONFIG_UID16 is not set
# CONFIG_SGETMASK_SYSCALL is not set
# vsyscall page emulation: only static glibc binaries from before 2011 use it; without it, there is no
# fixed address mapped in every process (equivalent to vsyscall=none)
# CONFIG_X86_VSYSCALL_EMULATION is not set
# Device coredumps (Wi-Fi firmware, GPU), turned on in the 1st build to debug iwlwifi and i915.
# Kconfig: "If unsure, say Y", with only a note to "Say 'N' for more sensitive systems"; the dump is only readable by root and disappears after 5 minutes.
CONFIG_ALLOW_DEV_COREDUMP=y
# Firmware memory maps in /sys/firmware: only kexec, which went away, uses them
# CONFIG_EFI_RUNTIME_MAP is not set
# CONFIG_FIRMWARE_MEMMAP is not set
# VGA text console: boot is UEFI only, and the console uses the framebuffer
# CONFIG_VGA_CONSOLE is not set
# HD-audio codecs that don't exist here: the codec is from the ALC269 family and the HDMI ones are Intel's and NVIDIA's
# (snd_hda_codec_alc269, _intelhdmi and _nvhdmi in modprobed.db)
# CONFIG_SND_HDA_CODEC_ALC260 is not set
# CONFIG_SND_HDA_CODEC_ALC262 is not set
# CONFIG_SND_HDA_CODEC_ALC268 is not set
# CONFIG_SND_HDA_CODEC_ALC662 is not set
# CONFIG_SND_HDA_CODEC_ALC680 is not set
# CONFIG_SND_HDA_CODEC_ALC861 is not set
# CONFIG_SND_HDA_CODEC_ALC861VD is not set
# CONFIG_SND_HDA_CODEC_ALC880 is not set
# CONFIG_SND_HDA_CODEC_ALC882 is not set
# CONFIG_SND_HDA_CODEC_HDMI_ATI is not set
# CONFIG_SND_HDA_CODEC_HDMI_NVIDIA_MCP is not set
# CONFIG_SND_HDA_CODEC_HDMI_TEGRA is not set

# =====================================================================================
# 9. The 1st build's choices and fixes (2026-11-11)
# =====================================================================================
# menuconfig-diff.txt isn't reapplied on the next build: what was chosen in menuconfig and kept is here.

# Fixes: sd-encrypt requires dm-integrity ("module not found: 'dm_integrity'" in mkinitcpio), and tkg
# turns off SYSFB_SIMPLEFB (prepare: _disable "SYSFB_SIMPLEFB"), which leaves simpledrm without a framebuffer and the
# LUKS prompt invisible. The fragment is applied after tkg's tweaks and undoes them.
CONFIG_DM_INTEGRITY=m
CONFIG_SYSFB_SIMPLEFB=y

# TCP: the default must be built in. The other algorithms go (2026-11-13: Westwood+, Vegas, YeAH and BBR aren't
# used; localmodconfig already removes the rest).
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_CUBIC=y
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_VEGAS is not set
# CONFIG_TCP_CONG_YEAH is not set
# CONFIG_TCP_CONG_BBR is not set

# Built only for this CPU (-march=native). The kernel no longer boots on another machine, which is intentional here (§0).
CONFIG_X86_NATIVE_CPU=y

# Suspend/resume watchdog: warns at 60 s and panics at 120 s (saved to pstore) if a driver hangs
# suspend or resume, the kind of failure behind the 2026-11-10 hang (§32A.16).
CONFIG_DPM_WATCHDOG=y
CONFIG_DPM_WATCHDOG_TIMEOUT=120
CONFIG_DPM_WATCHDOG_WARNING_TIMEOUT=60

# Reading and writing the EC through /sys/kernel/debug/ec: turned on in the 1st build's menuconfig and removed right after. The
# Kconfig warns that writing wrong values can confuse the EC badly enough to require pulling the battery.
# CONFIG_ACPI_EC_DEBUGFS is not set

# THP only for those who ask with madvise (the 1st build's decision; "always" before)
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# HVO on by default for HugeTLB pages (the VMs with hugepages, §16)
CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP_DEFAULT_ON=y

# EDID passed on by the firmware (the boot display's): only simpledrm would use it. i915 and nvidia read each
# output's EDID straight from the panel and the monitors (2026-11-13).
# CONFIG_FIRMWARE_EDID is not set

# SOF: the RPL-S audio controller (8086:7a50) is on pci-tgl.c's list, enabled by ALDERLAKE
# CONFIG_SND_SOC_SOF_TIGERLAKE is not set
CONFIG_SND_SOC_SOF_ALDERLAKE=m

# USB: local printer (the one at home is a network printer, §15). USB_STORAGE_DEBUG, turned on in menuconfig, went away: it writes
# a journal message for every command sent to a USB drive, with no way to turn it off (drivers/usb/storage/debug.c).
CONFIG_USB_PRINTER=m
# CONFIG_USB_STORAGE_DEBUG is not set

# LED triggers: no MTD here; the CPU one lights LEDs on each core's activity and there is no LED for that; the
# camera one is for platform cameras' (MIPI) flash LEDs, and the UVC webcam's LED is controlled by the hardware
# CONFIG_LEDS_TRIGGER_MTD is not set
# CONFIG_LEDS_TRIGGER_CPU is not set
# CONFIG_LEDS_TRIGGER_CAMERA is not set

# Rust bitmap API checks ("If unsure, say N", but chosen by the user; cost only in Rust code)
CONFIG_RUST_BITMAP_HARDENED=y

# Self-tests of the crypto API algorithms at registration (the Kconfig mentions blocking buggy drivers); without FULL
CONFIG_CRYPTO_SELFTESTS=y
# CONFIG_CRYPTO_SELFTESTS_FULL is not set
# Cryptography accelerators (QAT, CCP, VIA Padlock and the like): they don't exist here. The CPU's AES-NI and SHA-NI
# are in "Accelerated Cryptographic Algorithms for CPU" and don't depend on this.
# CONFIG_CRYPTO_HW is not set

# kmemleak out (2026-11-13): even when off at runtime, its hooks stay on every memory allocation, and hunting
# leaks inside the kernel isn't a realistic use here (§33.6).
# CONFIG_DEBUG_KMEMLEAK is not set
# NMI self-test at boot, once ("If unsure, say N", but chosen by the user; cost only at boot)
CONFIG_DEBUG_NMI_SELFTEST=y

# CPU crashlog (firmware: Cpu CrashLog on, 2026-11-12): a record of the CPU's state on a severe hardware
# error, which survives a reboot and complements pstore (§32A.16). Read in /sys/class/intel_pmt/crashlog*.
# localmodconfig was removing it because the device was off in the firmware.
CONFIG_INTEL_PMT_CRASHLOG=m

# Ethernet and Wi-Fi vendor menus: they only hide prompts, but they stayed on (localmodconfig already removes
# the drivers). Realtek (r8169) and Intel for Wi-Fi (iwlwifi) stay.
# CONFIG_NET_VENDOR_3COM is not set
# CONFIG_NET_VENDOR_ADAPTEC is not set
# CONFIG_NET_VENDOR_AGERE is not set
# CONFIG_NET_VENDOR_ALACRITECH is not set
# CONFIG_NET_VENDOR_ALIBABA is not set
# CONFIG_NET_VENDOR_AMAZON is not set
# CONFIG_NET_VENDOR_AMD is not set
