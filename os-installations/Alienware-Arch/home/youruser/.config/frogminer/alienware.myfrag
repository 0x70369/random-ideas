# alienware.myfrag: fragmento fixo do linux-tkg para o Alienware m16 R1
#
# Base: linux-tkg-config/7.2/config.x86_64 (= configuração do `linux` do Arch), depois do
# `make localmodconfig` do modprobed-db. Aplicado pelo merge_config.sh -m e depois olddefconfig.
# Validado contra o Kconfig do 7.2.15: cada linha abaixo fica com o valor pedido.
#
# As referências "(§N)" apontam para o documento de inventário do laptop.
# Não renomear: o _diffconfig grava em menuconfig-diff.txt, que não termina em .myfrag.
#
# O localmodconfig só desliga opções m sem módulo no banco. Este fragmento cuida do resto:
# 1. religa o debug que o _STRIP="true" desliga;
# 2. desliga o que cobre hardware ausente ou o papel de guest (opções y que o localmodconfig não toca);
# 3. passa para m o que não precisa estar embutido;
# 4. reforça como m os módulos de uso raro já declarados, para o caso de o banco não os ter.

# =====================================================================================
# 1. Debug (§31, §33.6)
# =====================================================================================

# _STRIP="true" liga DEBUG_INFO_NONE, que desligaria o BTF. O BPF LSM do systemd exige BTF.
# O DWARF serve para gerar o BTF; o INSTALL_MOD_STRIP=1 o tira dos módulos instalados e mantém a seção .BTF.
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_DEBUG_INFO_COMPRESSED_ZSTD=y

# Testes, injeção de falhas e debug só para desenvolvedores (§33.4, §33.6: "test/mock/simulator/fault-injection/developer-only fora").
# O que o §33.6 manda manter (IKCONFIG, KALLSYMS_ALL, DYNAMIC_DEBUG, ftrace, kprobes,
# uprobes, perf, BPF_EVENTS, debugfs, pstore, MAGIC_SYSRQ) não é tocado aqui.
# CONFIG_X86_DECODER_SELFTEST is not set
# CONFIG_DEBUG_RODATA_TEST is not set
# CONFIG_DEBUG_SHIRQ is not set
# CONFIG_RUNTIME_TESTING_MENU is not set
# CONFIG_FUNCTION_ERROR_INJECTION is not set
# CONFIG_BLK_ERROR_INJECTION is not set
# Kconfig: "If you are not helping to develop drivers, say N".
# CONFIG_MMIOTRACE is not set
# Debug por porta USB 3 com cabo de debug e um segundo computador. Kconfig: "If unsure, say 'N'".
# CONFIG_USB_XHCI_DBGCAP is not set
# CONFIG_EARLY_PRINTK_USB_XDBC is not set
# Early printk pela porta de debug EHCI: não há controlador EHCI. Kconfig: "You should normally say N here".
# CONFIG_EARLY_PRINTK_DBGP is not set
# Log do firmware OVMF: só existe dentro de uma VM.
# CONFIG_OVMF_DEBUG_LOG is not set

# pstore por EFI (§8): a configuração do Arch desliga o backend EFI por padrão (pstore_disable=Y no zen,
# conferido em 2026-11-09), então nenhum crash era gravado. O padrão do Kconfig é ligado. Cada crash grava
# alguns KB na NVRAM. O systemd-pstore.service move os registros para /var/lib/systemd/pstore e os apaga
# da NVRAM na inicialização seguinte; ele precisa estar habilitado (systemctl enable systemd-pstore.service).
# CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE is not set

# kexec e kdump: o diagnóstico de crash usa o pstore (§8), e o kdump não está configurado.
# Com o lockdown em "none" (§18), o kexec_load permite ao root iniciar um kernel não assinado
# sem passar pelo Secure Boot (§33.5: reduzir superfície de ataque).
# Para usar `systemctl kexec` ou o kdump, religar KEXEC_FILE com KEXEC_SIG.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# Kexec HandOver e Live Update (atualizar o kernel de servidores por kexec sem perder as VMs);
# o KEXEC_HANDOVER seleciona KEXEC_FILE
# CONFIG_KEXEC_HANDOVER is not set
# CONFIG_LIVEUPDATE is not set
# Verificação de assinatura de arquivos PE: só o kexec a usava
# CONFIG_SIGNED_PE_FILE_VERIFICATION is not set

# =====================================================================================
# 2. CPU, plataforma e papel de host (§2, §16, §33.7, §33.8)
# =====================================================================================

# CPU Intel apenas (i9-13900HX). O suporte às outras CPUs só sai com EXPERT (bloco 8).
# CONFIG_AMD_IOMMU is not set
# CONFIG_IOMMU_PT_AMDV1 is not set
# CONFIG_AMD_3D_VCACHE is not set
# CONFIG_AMD_MEM_ENCRYPT is not set
# CONFIG_X86_AMD_PLATFORM_DEVICE is not set
# CONFIG_AMD_WBRF is not set
# CONFIG_PINCTRL_AMD is not set
# CONFIG_USB_PCI_AMD is not set
# CONFIG_SND_SOC_SOF_AMD_TOPLEVEL is not set
# CONFIG_SND_AMD_ACP_CONFIG is not set
# CONFIG_X86_MCE_AMD is not set
# CONFIG_AMD_NUMA is not set
# CONFIG_PERF_EVENTS_AMD_BRS is not set
# CONFIG_AMD_HFI is not set
# CONFIG_CRYPTO_DEV_CCP is not set
# Mitigações de falhas que só existem em CPUs AMD (todas "depends on CPU_SUP_AMD"): retbleed=unret/ibpb,
# SRSO e TSA. As mitigações da Intel e as comuns ficam todas.
# CONFIG_MITIGATION_UNRET_ENTRY is not set
# CONFIG_MITIGATION_IBPB_ENTRY is not set
# CONFIG_MITIGATION_SRSO is not set
# CONFIG_MITIGATION_TSA is not set

# Recursos que o processador não tem: TDX é só em Xeon, e a flag sgx não aparece (conferido em 2026-11-09)
# CONFIG_INTEL_TDX_HOST is not set
# CONFIG_X86_SGX is not set
# Turbo Boost Max 3.0: Kconfig "only required when the system is not using Hardware P-States (HWP)";
# aqui o intel_pstate está em modo active com HWP (§32A)
# CONFIG_INTEL_TURBO_MAX_3 is not set
# Tabela MPS: Kconfig "For old smp systems that do not have proper acpi support"
# CONFIG_X86_MPPARSE is not set

# RDT/resctrl (CAT, CMT, MBA): a CPU não tem as flags rdt_a, cat_l2/l3, cqm e mba (conferido em 2026-11-09)
# CONFIG_X86_CPU_RESCTRL is not set

# Plataformas Intel antigas/embarcadas: Merrifield (SCU), Bay Trail/Cherry Trail (PMIC Crystal Cove
# e Whiskey Cove, pinctrl, semáforo I2C), notebooks com UEFI de 32 bits
# CONFIG_INTEL_SCU_PCI is not set
# CONFIG_INTEL_SOC_PMIC is not set
# CONFIG_INTEL_SOC_PMIC_CHTWC is not set
# CONFIG_PINCTRL_BAYTRAIL is not set
# CONFIG_PINCTRL_CHERRYVIEW is not set
# CONFIG_I2C_DESIGNWARE_BAYTRAIL is not set
# CONFIG_EFI_MIXED is not set
# Protocolo EFI handover (DEPRECATED): só bootloaders antigos e GRUB com patches o usam. A UKI entra
# pelo ponto de entrada PE normal do EFI stub, e o initrd vem pelo LoadFile2.
# CONFIG_EFI_HANDOVER_PROTOCOL is not set
# Tabela RCI2 (servidores Dell PowerEdge), segredos e heaps de computação confidencial (guest)
# CONFIG_EFI_RCI2_TABLE is not set
# CONFIG_EFI_COCO_SECRET is not set
# CONFIG_DMABUF_HEAPS_SYSTEM_CC_SHARED is not set

# Plataformas de outros fabricantes (§33.7: "ChromeOS EC não é necessário só porque laptop tem EC")
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_GOOGLE_FIRMWARE is not set
# CONFIG_SURFACE_PLATFORMS is not set
# CONFIG_MELLANOX_PLATFORM is not set
# CONFIG_X86_PLATFORM_DRIVERS_HP is not set
# CONFIG_X86_PLATFORM_DRIVERS_UNIWILL is not set

# Guest: este kernel nunca roda dentro de uma VM (§0, §16, §33.8).
# HYPERVISOR_GUEST leva junto PARAVIRT, KVM_GUEST, Xen, Jailhouse, ACRN e TDX guest.
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_HYPERV is not set
# CONFIG_VMGENID is not set
# CONFIG_PVPANIC is not set
# CONFIG_VIRT_DRIVERS is not set
# CONFIG_MOUSE_PS2_VMMOUSE is not set
# Frontends VirtIO (as placas virtio da VM são servidas pelo vhost_net do host, que fica)
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_SCSI_VIRTIO is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_FS is not set
# CONFIG_VIRTIO_MENU is not set
# Processadores auxiliares de SoCs ARM; seleciona o núcleo VirtIO
# CONFIG_REMOTEPROC is not set

# KVM do host: só Intel, sem TDX e sem emulação de Xen para guests (§16: "não usa Xen").
# KVM_HYPERV fica: são as enlightenments Hyper-V que as VMs Windows usam.
# CONFIG_KVM_AMD is not set
# CONFIG_KVM_INTEL_TDX is not set
# CONFIG_KVM_XEN is not set

# IOMMU ligado por padrão (§1B, §31): torna o intel_iommu=on dispensável.
# O parâmetro pode ficar no cmdline.d sem efeito colateral.
CONFIG_INTEL_IOMMU_DEFAULT_ON=y

# ABI x32: nenhum programa do Arch a usa; é código de syscalls exposto sem uso (§33.5).
# O IA32 (32 bits, Steam/Wine) fica.
# CONFIG_X86_X32_ABI is not set

# /dev/mem e /dev/port: acesso bruto à memória física e às portas de E/S (§33.5). O único usuário seria o
# intel-undervolt, para limites de potência e Tjunction por MMIO, mas a configuração dele só tem undervolt
# (pelo msr), e os limites de potência vêm do tuned pelo powercap (conferido em 2026-11-10). Se um dia
# usar as linhas "power" ou "tjoffset" do intel-undervolt, religar DEVMEM.
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# /dev/snapshot (uswsusp). Kconfig: "Say N if no snapshotting from userspace is needed, this also reduces
# the attack surface of the kernel". O systemd hiberna pelo /sys/power/state.
# CONFIG_HIBERNATION_SNAPSHOT_DEV is not set

# ioperm()/iopl(): Kconfig "necessary for legacy applications"; acesso bruto a todas as portas de
# E/S (§33.5: evitar raw access). Nada declarado no inventário usa.
# CONFIG_X86_IOPL_IOPERM is not set

# MSR e CPUID como módulos. O msr não carrega sozinho ao abrir /dev/cpu/*/msr, mas o intel-undervolt
# (§32) roda "/sbin/modprobe msr" antes de abri-lo.
CONFIG_X86_MSR=m
CONFIG_X86_CPUID=m

# Hibernação com lz4 por padrão (§1B, §8). Dispensa o hibernate.compressor=lz4.
# O zswap já tem zstd como padrão e o CRYPTO_ZSTD já é y na base, então o compressor está disponível
# na initcall do zswap (§33.3).
CONFIG_HIBERNATION_COMP_LZ4=y

# =====================================================================================
# 3. Desligar: módulos carregados só por causa da configuração (§2 "Desligar")
# =====================================================================================

# Bluetooth interno é Intel (btintel)
# CONFIG_BT_HCIBTUSB_RTL is not set
# CONFIG_BT_HCIBTUSB_BCM is not set
# CONFIG_BT_HCIBTUSB_MTK is not set
# iGPU Raptor Lake no i915; dGPU no nvidia-open-dkms
# ATENÇÃO: o DRM_XE (pelo DRM_GPUSVM) é o único que seleciona HMM_MIRROR nesta configuração, e o
# HMM_MIRROR não tem pergunta própria no Kconfig. Sem ele, o nvidia-uvm compila sem HMM (o CUDA
# deixa de acessar memória alocada com malloc comum; cudaMalloc e memória gerenciada continuam).
# NVENC/NVDEC, Vulkan, NVML e PRIME não usam HMM. Para manter o HMM, trocar a linha abaixo por
# CONFIG_DRM_XE=m (o xe compila, mas não se liga à iGPU Raptor Lake sem force_probe).
# CONFIG_DRM_XE is not set
# CONFIG_DRM_NOUVEAU is not set
# Áudio pelo SOF, sem dispositivo SoundWire. Nada que fica ligado seleciona o SOUNDWIRE: saem também
# os controladores soundwire_intel/_cadence (no modprobed.db) e o soundwire_amd. SOF, HDA e SDCA ficam.
# CONFIG_SND_SOC_INTEL_AVS is not set
# CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE is not set
# CONFIG_SOUNDWIRE is not set

# =====================================================================================
# 4. Hardware ausente (§0, §33.1, §33.7)
# =====================================================================================

# Sem controlador SATA/AHCI no PCI (só NVMe). Discos SATA externos usam usb-storage/uas.
# CONFIG_ATA is not set
# NVMe: um SSD de porta única, sem NVMe over Fabrics. Sem a autenticação do Fabrics, os módulos nvme_auth
# e nvme_keyring (no modprobed.db só por dependência) deixam de existir.
# CONFIG_NVME_MULTIPATH is not set
# CONFIG_NVME_HOST_AUTH is not set
# Núcleo DAX: sem memória persistente nem CXL, e o FS_DAX sai abaixo
# CONFIG_DAX is not set
# Sem discos zonados (SMR host-managed/ZNS), sem NVDIMM/CXL (DAX, HMAT), sem doca ACPI (as docas são
# Thunderbolt), sem troca de memória a quente, sem HBAs e SAN
# CONFIG_BLK_DEV_ZONED is not set
# CONFIG_FS_DAX is not set
# CONFIG_ACPI_HMAT is not set
# CONFIG_ACPI_DOCK is not set
# CONFIG_ACPI_HOTPLUG_MEMORY is not set
# CONFIG_FUSION is not set
# CONFIG_SCSI_DH is not set
# CONFIG_NET_FC is not set
# PCI: sem SR-IOV, TSM, LEDs de gaveta (NPEM), CompactPCI, SHPC (PCI-X) e controlador DesignWare.
# Ficam o hotplug PCIe e o ACPI, que o Thunderbolt usa, e o P2PDMA, do qual depende o VFIO_PCI_DMABUF.
# CONFIG_PCI_IOV is not set
# CONFIG_PCI_TSM is not set
# CONFIG_PCI_NPEM is not set
# CONFIG_HOTPLUG_PCI_CPCI is not set
# CONFIG_HOTPLUG_PCI_SHPC is not set
# CONFIG_PCIE_DW_PLAT_HOST is not set
# Aceleradores de computação (NPU, Habana): a NPU da Intel começa no Meteor Lake
# CONFIG_DRM_ACCEL is not set
# Sem AGP; o i915 usa o INTEL_GTT, selecionado por ele mesmo
# CONFIG_AGP is not set
# Boot só por UEFI: sem VESA do BIOS legado (o simpledrm e o efifb ficam, §18, §33.3)
# CONFIG_FB_VESA is not set
# Sem controladores EHCI/OHCI/UHCI: só xHCI (PCH e Thunderbolt)
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_UHCI_HCD is not set
# DesignWare DMA (o LPSS usa o idma64) e DesignWare I2C PCI (§26: o LPSS usa o DesignWare platform)
# CONFIG_DW_DMAC_PCI is not set
# CONFIG_I2C_DESIGNWARE_PCI is not set
# ACPI_FAN fica como m: não há ventoinha ACPI (PNP0C0B/INTC1048 ausentes), mas o INT340X_THERMAL
# (DPTF, em uso, §22) o seleciona. O módulo fan só carrega se houver o dispositivo.
CONFIG_ACPI_FAN=m
# Sem nenhuma porta serial UART: o driver 8250 só registra as 32 portas vazias, sem nenhum "ttySN is a
# 16550A" no dmesg e sem dispositivo PNP0501 (conferido em 2026-11-09). O "serial8250" ligado do §2 é o
# dispositivo de plataforma que o próprio driver cria. Os adaptadores USB serial (§13) não dependem dele.
# CONFIG_SERIAL_8250 is not set
# CONFIG_SERIAL_NONSTANDARD is not set
# Modo target SPI (o PC é o controlador)
# CONFIG_SPI_SLAVE is not set
# Barramento serdev: dispositivos ligados a UARTs internas (Bluetooth UART de SoCs); o Bluetooth aqui é USB
# CONFIG_SERIAL_DEV_BUS is not set
# Modo target I2C
# CONFIG_I2C_SLAVE is not set
# Bluetooth por PCIe (Lunar Lake em diante): aqui o Bluetooth é USB
# CONFIG_BT_INTEL_PCIE is not set
# Offload de áudio USB pelo xHCI (plataformas Qualcomm)
# CONFIG_USB_XHCI_SIDEBAND is not set
# Infraestrutura de SoC sem usuário aqui: devfreq, HTE, hwspinlock, interconnect, controladores de memória,
# multiplexadores, reset de placa, DMA do Lightning Mountain, offload de RAID, PoE, VCAP
# CONFIG_PM_DEVFREQ is not set
# CONFIG_HTE is not set
# CONFIG_HWSPINLOCK is not set
# CONFIG_INTERCONNECT is not set
# CONFIG_MEMORY is not set
# CONFIG_MUX_CORE is not set
# CONFIG_POWER_RESET is not set
# CONFIG_INTEL_LDMA is not set
# CONFIG_ASYNC_TX_DMA is not set
# CONFIG_PSE_CONTROLLER is not set
# CONFIG_VCAP is not set
# Recursos de RAS de servidor (scrub, ECS e reparo de memória por CXL/ACPI RAS2)
# CONFIG_EDAC_SCRUB is not set
# CONFIG_EDAC_ECS is not set
# CONFIG_EDAC_MEM_REPAIR is not set
# OpRegion de PMIC (Bay Trail/Cherry Trail)
# CONFIG_PMIC_OPREGION is not set
# PMICs de placas embarcadas, embutidos como bool (§29: "PMIC drivers não são necessários só por haver bateria")
# CONFIG_MFD_88PM860X is not set
# CONFIG_MFD_AAT2870_CORE is not set
# CONFIG_MFD_AS3711 is not set
# CONFIG_MFD_DA9052_I2C is not set
# CONFIG_MFD_DA9052_SPI is not set
# CONFIG_MFD_DA9055 is not set
# CONFIG_MFD_LP8788 is not set
# CONFIG_MFD_MAX77843 is not set
# CONFIG_MFD_MAX8925 is not set
# CONFIG_MFD_MAX8997 is not set
# CONFIG_MFD_MAX8998 is not set
# CONFIG_MFD_RC5T583 is not set
# CONFIG_MFD_TPS65090 is not set
# CONFIG_MFD_TPS6586X is not set
# CONFIG_MFD_TPS65910 is not set
# CONFIG_MFD_TWL4030_AUDIO is not set
# CONFIG_MFD_WM831X_I2C is not set
# CONFIG_MFD_WM831X_SPI is not set
# CONFIG_MFD_WM8350_I2C is not set
# CONFIG_MFD_WM8400 is not set
# CONFIG_PMIC_ADP5520 is not set
# CONFIG_PMIC_DA903X is not set
# CONFIG_TWL4030_CORE is not set
# CONFIG_TWL6040_CORE is not set
# CONFIG_PINCTRL_SX150X is not set
# Touchscreen e mesa digitalizadora: não há
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_TABLET is not set
# Extensões PS/2 de touchpads de outros fabricantes que aparecem sem EXPERT (as demais estão no bloco 8)
# CONFIG_MOUSE_PS2_ELANTECH is not set
# CONFIG_MOUSE_PS2_SENTELIC is not set
# CONFIG_MOUSE_PS2_TOUCHKIT is not set
# TV analógica e digital, rádio, câmeras de plataforma (MIPI/IPU ausentes, §2), placas de captura PCI
# e drivers de teste de mídia. Ficam câmera e mídia USB (webcam UVC, §10).
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_PLATFORM_SUPPORT is not set
# CONFIG_MEDIA_PCI_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_VIDEO_CAMERA_SENSOR is not set
# CONFIG_VIDEO_CAMERA_LENS is not set
# CONFIG_STAGING is not set
# Controle remoto infravermelho (§12: "LIRC/IR considerado desnecessário"), inclusive o repasse
# de teclas de controle remoto pelo HDMI-CEC. O CEC do i915 (DP/HDMI) fica.
# CONFIG_LIRC is not set
# CONFIG_MEDIA_CEC_RC is not set
# CONFIG_RC_CORE is not set
# Flash NAND: a única flash é a SPI NOR do firmware (§27)
# CONFIG_MTD_NAND_ECC_SW_HAMMING is not set
# CONFIG_MTD_NAND_ECC_SW_BCH is not set
# CONFIG_MTD_NAND_ECC_MXIC is not set
# eMMC (RPMB): o leitor é de cartões SD (§9)
# CONFIG_RPMB is not set
# Interfaces de áudio USB específicas (Edirol UA-101, Tascam US-122/224/428): fora do modprobed.db
# CONFIG_SND_USB_UA101 is not set
# CONFIG_SND_USB_USX2Y is not set
# CONFIG_SND_USB_US122L is not set
# Manche Logitech G940 (os gamepads Logitech ficam, §12)
# CONFIG_LOGIG940_FF is not set
# Hardware de memória ECC: os pentes não são ECC (§3)
# CONFIG_EDAC_IE31200 is not set
# AlienFX pelo WMI legado: o GUID A90597CE não existe neste firmware (só o WMAX, A70591CE)
# CONFIG_ALIENWARE_WMI_LEGACY is not set
# USB networking: os aparelhos declarados (RPi, Android, iPhone, AX88179, RTL8152) usam
# CDC ECM/NCM, RNDIS, ipheth, ax88179_178a e r8152. O cdc_subset é de adaptadores antigos.
# CONFIG_USB_NET_CDC_SUBSET is not set

# =====================================================================================
# 5. Segurança e interfaces fora de uso (§33.5, decisões das seções)
# =====================================================================================

# LSMs compilados que não estão na lista ativa (§18: landlock, lockdown, yama, integrity, bpf). O AppArmor e
# o SELinux ficam por decisão do §31; estes não foram decididos lá e não têm uso.
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_LOADPIN is not set
# CONFIG_SECURITY_SAFESETID is not set
# CONFIG_SECURITY_IPE is not set
# Descompressores de initramfs: a UKI usa zstd (§8, COMPRESSION="zstd"). Religar o do formato escolhido se
# o mkinitcpio mudar de compressão.
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# Tabelas de partição: ficam GPT e MBR. As demais são interpretadores de dados de qualquer mídia conectada.
# CONFIG_AIX_PARTITION is not set
# CONFIG_MAC_PARTITION is not set
# CONFIG_BSD_DISKLABEL is not set
# CONFIG_MINIX_SUBPARTITION is not set
# CONFIG_SOLARIS_X86_PARTITION is not set
# CONFIG_LDM_PARTITION is not set
# CONFIG_KARMA_PARTITION is not set
# Driver NTFS novo (fs/ntfs), escolha do usuário no menuconfig do 1º build (2026-11-11). O NTFS_DEBUG só
# compila as mensagens de debug; elas ficam desligadas até serem ativadas.
CONFIG_NTFS_FS=m
CONFIG_NTFS_DEBUG=y
# Contabilidade de processos BSD (DEPRECATED) e controlador RDMA dos cgroups
# CONFIG_BSD_PROCESS_ACCT is not set
# CONFIG_CGROUP_RDMA is not set
# Rede de datacenter, de BMC e de roteadores: DCB, MCTP, NC-SI, MPLS, PSP, switchdev, netkit, cabeçalhos de
# roteamento IPv6 (SRv6, RPL, IOAM), protocolos de anel da bridge (MRP, CFM)
# CONFIG_DCB is not set
# CONFIG_MCTP is not set
# CONFIG_NET_NCSI is not set
# CONFIG_MPLS is not set
# CONFIG_INET_PSP is not set
# CONFIG_NET_SWITCHDEV is not set
# CONFIG_NETKIT is not set
# CONFIG_IPV6_SEG6_LWTUNNEL is not set
# CONFIG_IPV6_RPL_LWTUNNEL is not set
# CONFIG_IPV6_IOAM6_LWTUNNEL is not set
# CONFIG_BRIDGE_MRP is not set
# CONFIG_BRIDGE_CFM is not set
# macvlan/macvtap: o libvirt usa bridge e tun (§16). O localmodconfig os mantinha por causa do módulo tap,
# que só carregava como dependência do vhost_net.
# CONFIG_MACVLAN is not set
# CONFIG_MACVTAP is not set
# Chaves confiáveis por TEE (OP-TEE, AMD-TEE): só o TPM (§19). O módulo tee só carregava por dependência.
# CONFIG_TRUSTED_KEYS_TEE is not set
# CONFIG_TEE is not set
# Acessibilidade por console (braille, speakup)
# CONFIG_ACCESSIBILITY is not set
# TPM: interface CRB (§19). Sem TIS/FIFO.
# CONFIG_TCG_TIS is not set
# CONFIG_TCG_TIS_CORE is not set
# /proc/i8k legado (§23)
# CONFIG_I8K is not set
# Flash SPI: fica o spi_intel_pci; sai a variante de plataforma e o spidev (§27)
# CONFIG_SPI_INTEL_PLATFORM is not set
# CONFIG_SPI_SPIDEV is not set
# Watchdog: só o iTCO; sem pretimeout e sem softdog (§20)
# CONFIG_WATCHDOG_PRETIMEOUT_GOV is not set
# CONFIG_SOFT_WATCHDOG is not set
# Watchdog do iAMT no MEI (§25)
# CONFIG_INTEL_MEI_WDT is not set
# PCH thermal antigo e emulação térmica (§22)
# CONFIG_INTEL_PCH_THERMAL is not set
# CONFIG_THERMAL_EMULATION is not set
# Emulação OSS: o PipeWire usa ALSA (§5)
# CONFIG_SND_OSSEMUL is not set
# /dev/nvram (CMOS do BIOS legado): só o thinkpad_acpi o seleciona; o hwclock usa o /dev/rtc
# CONFIG_NVRAM is not set

# Endurecimento (§0: segurança acima de performance). Regra: toda alavanca de segurança ligada, exceto as que o
# Kconfig manda deixar em N na dúvida ("If unsure, say N" ou equivalente) e as que quebrariam um uso declarado. As proteções da base continuam: KERNEL_IBT, shadow stack,
# INIT_STACK_ALL_ZERO, INIT_ON_ALLOC, HARDENED_USERCOPY, FORTIFY_SOURCE, SLAB_FREELIST_*, RANDOMIZE_KSTACK_OFFSET.
#
# Zera a memória ao liberar, além de ao alocar: dados apagados não ficam no heap. Custa mais que o
# init_on_alloc (Kconfig: "more expensive [...] due to the negative cache effects"). Para medir sem
# recompilar, init_on_free=0 na linha de comando desliga.
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
# Zera os registradores na saída das funções: menos vazamento por canal lateral e cerca de 20% menos gadgets
# de ROP. Kconfig: "less than 1% performance impact on most workloads".
CONFIG_ZERO_CALL_USED_REGS=y
# Caches do slab separados: um estouro de heap só atinge objetos do mesmo cache. Custa um pouco de
# fragmentação de memória (equivale ao slab_nomerge).
# CONFIG_SLAB_MERGE_DEFAULT is not set
# /proc/PID/mem nunca ignora as permissões das páginas. O gdb continua inserindo breakpoints pelo ptrace.
CONFIG_PROC_MEM_NO_FORCE=y
# Várias cópias isoladas dos caches de kmalloc: objetos de subsistemas diferentes não ficam lado a lado
CONFIG_KMALLOC_PARTITION_CACHES=y
# Módulo sem assinatura válida não carrega (antes só marcava o kernel como tainted). Os módulos do kernel são
# assinados no build (MODULE_SIG_ALL), e os do DKMS (nvidia, kvmfr) com a MOK, na qual o kernel confia pelo
# keyring da máquina (§18). Se a assinatura do DKMS falhar, o nvidia não carrega: use o linux ou o linux-zen.
CONFIG_MODULE_SIG_FORCE=y
# Lockdown iniciado antes dos outros LSMs. Com o lockdown forçado em "none" (§18: o modo integrity impede a
# hibernação), só tem efeito se um dia o lockdown for ligado.
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# UBSAN: verificação de índices de arrays e de comportamentos indefinidos. O trap (abortar em vez de avisar)
# derrubaria o kernel por comportamentos inofensivos, inclusive nos módulos do DKMS, compilados com as mesmas
# flags; o Kconfig avisa que ele "may destabilize the system".
# Decisão do 1º build (2026-11-11): detectores de shift, divisão por zero, bool e enum ligados, e o trap
# DESLIGADO, para que todos só avisem no dmesg ("UBSAN: ...") em vez de derrubar o kernel ou o nvidia.
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
# CONFIG_UBSAN_TRAP is not set
CONFIG_UBSAN_SHIFT=y
CONFIG_UBSAN_DIV_ZERO=y
# CONFIG_UBSAN_UNREACHABLE is not set
# CONFIG_UBSAN_INTEGER_WRAP is not set
CONFIG_UBSAN_BOOL=y
CONFIG_UBSAN_ENUM=y
# CONFIG_UBSAN_ALIGNMENT is not set
# modprobe --force e rmmod -f. Kconfig: "usually a really bad idea" e "If unsure, say N".
# CONFIG_MODULE_FORCE_LOAD is not set
# CONFIG_MODULE_FORCE_UNLOAD is not set
# Disciplinas de linha antigas (N_HDLC, N_GSM, PPP...) não carregam mais por pedido de usuário comum.
# Nenhuma é usada; o root ainda pode carregá-las.
# CONFIG_LDISC_AUTOLOAD is not set
#
# Ficam em N porque o Kconfig manda: BUG_ON_DATA_CORRUPTION e PANIC_ON_OOPS ("If unsure, say N"),
# PAGE_TABLE_CHECK ("If unsure say n"), STRICT_SIGALTSTACK_SIZE ("Say 'N' unless you want to really enforce"),
# IMA e EVM ("answer N"), além de MODULE_FORCE_UNLOAD e SYSFS_SYSCALL, já desligados acima ou na base.
# CONFIG_BUG_ON_DATA_CORRUPTION is not set
# CONFIG_PANIC_ON_OOPS is not set
# CONFIG_PAGE_TABLE_CHECK is not set
# CONFIG_STRICT_SIGALTSTACK_SIZE is not set
#
# Ficam desligadas porque quebrariam usos declarados:
# - STATIC_USERMODEHELPER: todas as chamadas a programas do espaço de usuário (modprobe dos módulos carregados
#   sob demanda, systemd-coredump) passariam por um único binário intermediário, que o Arch não tem
# - LOCK_DOWN_KERNEL_FORCE_INTEGRITY/CONFIDENTIALITY: impedem a hibernação (§18)
# - SECURITY_LOADPIN: só aceita módulos e firmware do primeiro sistema de arquivos usado, o initramfs
# - MODIFY_LDT_SYSCALL e X86_16BIT (bloco 8): o Wine precisa deles
# - INTEGRITY_CA_MACHINE_KEYRING: só põe no keyring da máquina as MOKs com CA:TRUE e keyUsage keyCertSign
#   (restrict_link_by_ca). MOK.crt e MOK-module-signing.crt têm CA:TRUE mas nenhum keyUsage (conferido em
#   2026-11-10): iriam para o keyring da plataforma, que não vale para módulos, e com o MODULE_SIG_FORCE o
#   nvidia e o kvmfr deixariam de carregar
#
# Não disponíveis com GCC: CFI (o GCC 16.2 não aceita -fsanitize=kcfi, conferido em 2026-11-10),
# KSTACK_ERASE (exige o callback de profundidade de pilha do Clang) e RANDSTRUCT (quebraria os módulos DKMS
# com objetos pré-compilados).

# Contadores de debug que ninguém lê, incrementados em caminhos quentes (locks e mudança de atributos de página)
# CONFIG_LOCK_EVENT_COUNTS is not set
# CONFIG_X86_CPA_STATISTICS is not set

# =====================================================================================
# 6. Embutido → módulo (§0, §19, §33.2, §33.3)
# =====================================================================================

# Ficam embutidas: BINFMT_SCRIPT, FW_LOADER, EFI_VARS_PSTORE (crashes desde o boot), TCP_CONG_CUBIC (o padrão
# do TCP precisa ser embutido; como módulo, o kernel cai para o Reno) e EFIVAR_FS (o systemd do initramfs lê a
# variável EFI HibernateLocation para achar a imagem de hibernação, sem resume= na linha de comando). As demais embutidas são selecionadas por
# opções embutidas e não podem mudar.
#
CONFIG_EFIVAR_FS=y
# Voltaram para y depois do 1º build (2026-11-11):
# - DRM, DRM_SIMPLEDRM e FB: tela desde o início do kernel (erros e panics antes do initramfs aparecem) e o
#   prompt do LUKS sem depender do MODULES; o i915 e o nvidia_drm carregam o núcleo DRM em todo boot de qualquer forma
# - ACPI_THERMAL: Kconfig "HIGHLY recommended"; como módulo, as zonas térmicas do firmware só valiam depois do LUKS
# - RTC_DRV_CMOS: relógio certo desde o boot (RTC_HCTOSYS), inclusive no journal do initramfs
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_ACPI_THERMAL=y
CONFIG_RTC_DRV_CMOS=y
#
# Viraram módulo no menuconfig do 1º build (2026-11-11), por escolha do usuário. Consequências conferidas:
# - MQ_IOSCHED_DEADLINE: o kernel não o carrega sozinho; uma regra do udev o pede para discos USB e SD
# - CONNECTOR: o PROC_EVENTS (eventos de fork/exec/exit por netlink) exige y e some
# - NET_SCH_FQ_CODEL: o sysctl net.core.default_qdisc do systemd (50-default.conf) o carrega no boot
CONFIG_IKCONFIG=m
CONFIG_IKHEADERS=m
CONFIG_MQ_IOSCHED_DEADLINE=m
CONFIG_PACKET=m
CONFIG_PACKET_DIAG=m
CONFIG_UNIX_DIAG=m
CONFIG_CONNECTOR=m
CONFIG_INPUT_LEDS=m
CONFIG_INPUT_EVDEV=m
CONFIG_SERIO=m
CONFIG_HWMON=m
CONFIG_WATCHDOG_CORE=m
CONFIG_BACKLIGHT_CLASS_DEVICE=m
CONFIG_HID=m
CONFIG_USB=m
CONFIG_LEDS_CLASS=m
CONFIG_EDAC=m
CONFIG_EDAC_GHES=m
CONFIG_UNICODE=m
CONFIG_CRYPTO_DRBG=m
CONFIG_CRYPTO_JITTERENTROPY=m
CONFIG_CRYPTO_PCRYPT=m
CONFIG_CRYPTO_LZ4HC=m
#
# Podem ser m sem mudar o mkinitcpio (§33.3): o autodetect e os hooks já os põem na UKI.
# O núcleo NLS fica y: o ACPI e o USB, embutidos, o selecionam. As codepages viram módulos.
CONFIG_TCG_TPM=m
CONFIG_TCG_CRB=m
CONFIG_BTRFS_FS=m
CONFIG_CRYPTO_XTS=m
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_XHCI_PCI=m
CONFIG_USB_HID=m
CONFIG_HID_GENERIC=m
CONFIG_SERIO_I8042=m
CONFIG_KEYBOARD_ATKBD=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ASCII=m
# Disco: o hook block sempre inclui sd_mod (e o scsi_mod vem como dependência)
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
# I2C DesignWare do LPSS (§26: "pode ser modular"); o core I2C fica y
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
# Carregados sob demanda: escalonadores de E/S ao escrever em /sys/block/*/queue/scheduler (fica embutido o
# mq-deadline, padrão dos discos USB, que o kernel não carrega sozinho); governors genéricos do cpufreq (o
# intel_pstate em modo active não os usa; o kernel os carrega ao escolher um em scaling_governor); algoritmos
# de criptografia, pelos aliases crypto-* (o hook sd-encrypt põe todos no initramfs, §33.3)
CONFIG_IOSCHED_BFQ=m
CONFIG_MQ_IOSCHED_KYBER=m
CONFIG_CPU_FREQ_GOV_POWERSAVE=m
CONFIG_CPU_FREQ_GOV_USERSPACE=m
CONFIG_CPU_FREQ_GOV_ONDEMAND=m
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=m
CONFIG_CRYPTO_AES=m
CONFIG_CRYPTO_CBC=m
CONFIG_CRYPTO_CTR=m
CONFIG_CRYPTO_CTS=m
CONFIG_CRYPTO_ECDH=m
CONFIG_CRYPTO_MD5=m
CONFIG_CRYPTO_SHA1=m
CONFIG_CRYPTO_SHA3=m
CONFIG_CRYPTO_BLAKE2B=m
CONFIG_CRYPTO_XXHASH=m
CONFIG_CRYPTO_CRC32C=m
# Sem usuário no boot: núcleo de hwrng (só o TPM, também módulo, o usa), heaps de dma-buf, extcon, tabelas DMI
# brutas em /sys/firmware/dmi/entries, pci-stub (o passthrough usa o vfio-pci), drop_monitor (dropwatch)
CONFIG_HW_RANDOM=m
CONFIG_DMABUF_HEAPS_SYSTEM=m
CONFIG_DMABUF_HEAPS_CMA=m
CONFIG_EXTCON=m
CONFIG_DMI_SYSFS=m
CONFIG_PCI_STUB=m
CONFIG_NET_DROP_MONITOR=m
# Carregados por udev, pelo systemd ou ao montar; nenhum é usado antes do initramfs
CONFIG_FUSE_FS=m
CONFIG_AUTOFS_FS=m
CONFIG_CONFIGFS_FS=m
CONFIG_BINFMT_MISC=m
CONFIG_ACPI_AC=m
CONFIG_ACPI_BATTERY=m
CONFIG_ACPI_BUTTON=m
CONFIG_USB_SERIAL=m
# ext4 não é declarado, mas é o sistema de arquivos do cartão de um Raspberry Pi (§13). Fica como
# módulo em vez de embutido.
CONFIG_EXT4_FS=m

# =====================================================================================
# 7. Rede de segurança: módulos de uso raro já declarados (§31)
# =====================================================================================
# Se o modprobed-db não os tiver visto, o localmodconfig os desliga; o fragmento os religa.
# Pedir um valor m para uma opção que já é m não muda nada.

# Mídias externas e imagens (§8): exFAT, FAT, ISO 9660 com Joliet/Rock Ridge/zisofs, UDF, loop, nbd, uas
CONFIG_EXFAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_NLS_UTF8=m
CONFIG_NLS_ISO8859_1=m
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_BLK_DEV_NBD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_CHR_DEV_SG=m
# Hibernação lz4 (§1B)
CONFIG_CRYPTO_LZ4=y

# USB serial: Arduino/ESP32/RPi (§13)
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m

# USB networking e telefones (§6, §13, §14)
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_RTL8152=m
CONFIG_USB_IPHETH=m

# Gamepads e Steam Input (§12)
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
CONFIG_HID_MICROSOFT=m
CONFIG_HID_LOGITECH=m
CONFIG_LOGITECH_FF=y
# Volantes: o usuário ainda não tem um (§12, 2026-11-10). Ao comprar, religar o driver da marca: para os
# Logitech G25/G27/G29/G920, LOGIWHEELS_FF; para os que seguem o padrão USB PID, HID_PID.
# CONFIG_LOGIWHEELS_FF is not set
# CONFIG_HID_PID is not set
CONFIG_USB_HIDDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_JOYDEV=m

# SMBus do PCH: SPD5118 da RAM e o iTCO (§20, §23, §26)
CONFIG_I2C_I801=m

# Logitech HID (§11)
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m

# Bluetooth: HID, áudio e rede (§6, §12)
CONFIG_BT_HIDP=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_UHID=m

# Áudio USB e MIDI (§5)
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_SEQ_HRTIMER_DEFAULT=y

# Virtualização (§16)
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_HYPERV=y
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VHOST_NET=m
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_DM_CRYPT=m
CONFIG_BLK_DEV_DM=m

# VPN (§6)
CONFIG_WIREGUARD=m

# QoS (§6): fq_codel padrão (módulo desde o 1º build; o tkg trocaria o padrão para o CAKE), FQ e CAKE como módulos
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_FLOWER=m
CONFIG_NET_CLS_MATCHALL=m
CONFIG_NET_ACT_GACT=m
CONFIG_NET_ACT_MIRRED=m

# Jogos (§17)
CONFIG_NTSYNC=m

# =====================================================================================
# 8. O que só pode sair com EXPERT
# =====================================================================================
# Estas opções só aparecem com EXPERT=y. O EXPERT só revela perguntas; testado no 7.2.15, ligá-lo não muda
# nenhuma outra opção desta configuração.
#
CONFIG_EXPERT=y
# Suporte a CPUs AMD, Hygon, Centaur (VIA) e Zhaoxin
CONFIG_PROCESSOR_SELECT=y
# CONFIG_CPU_SUP_AMD is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
# Protocolos PS/2 de touchpads e trackpoints de outros fabricantes
# CONFIG_MOUSE_PS2_ALPS is not set
# CONFIG_MOUSE_PS2_BYD is not set
# CONFIG_MOUSE_PS2_CYPRESS is not set
# CONFIG_MOUSE_PS2_FOCALTECH is not set
# CONFIG_MOUSE_PS2_LIFEBOOK is not set
# CONFIG_MOUSE_PS2_LOGIPS2PP is not set
# CONFIG_MOUSE_PS2_TRACKPOINT is not set
# /dev/gpiochipN e a ABI v1 desnecessários (§28)
# CONFIG_GPIO_CDEV is not set
# Interfaces antigas (§33.5): syscalls de UID de 16 bits e sgetmask/ssetmask (obsoletas, a libc não as usa)
# CONFIG_UID16 is not set
# CONFIG_SGETMASK_SYSCALL is not set
# Emulação da página vsyscall: só binários estáticos de glibc anteriores a 2011 a usam; sem ela, não existe
# endereço fixo mapeado em todo processo (equivale a vsyscall=none)
# CONFIG_X86_VSYSCALL_EMULATION is not set
# Coredumps de dispositivos (firmware do Wi-Fi, GPU), ligado no 1º build para depurar o iwlwifi e o i915.
# Kconfig: "Say 'N' for more sensitive systems"; o dump só é legível pelo root e some em 5 minutos.
CONFIG_ALLOW_DEV_COREDUMP=y
# Mapas de memória do firmware em /sys/firmware: só o kexec, que saiu, os usa
# CONFIG_EFI_RUNTIME_MAP is not set
# CONFIG_FIRMWARE_MEMMAP is not set
# Console de texto VGA: o boot é só UEFI, e o console usa o framebuffer
# CONFIG_VGA_CONSOLE is not set
# Codecs HD-audio que não existem aqui: o codec é da família ALC269 e os HDMI são o da Intel e o da NVIDIA
# (snd_hda_codec_alc269, _intelhdmi e _nvhdmi no modprobed.db)
# CONFIG_SND_HDA_CODEC_ALC260 is not set
# CONFIG_SND_HDA_CODEC_ALC262 is not set
# CONFIG_SND_HDA_CODEC_ALC268 is not set
# CONFIG_SND_HDA_CODEC_ALC662 is not set
# CONFIG_SND_HDA_CODEC_ALC680 is not set
# CONFIG_SND_HDA_CODEC_ALC861 is not set
# CONFIG_SND_HDA_CODEC_ALC861VD is not set
# CONFIG_SND_HDA_CODEC_ALC880 is not set
# CONFIG_SND_HDA_CODEC_ALC882 is not set
# CONFIG_SND_HDA_CODEC_HDMI_ATI is not set
# CONFIG_SND_HDA_CODEC_HDMI_NVIDIA_MCP is not set
# CONFIG_SND_HDA_CODEC_HDMI_TEGRA is not set

# =====================================================================================
# 9. Escolhas e correções do 1º build (2026-11-11)
# =====================================================================================
# O menuconfig-diff.txt não é reaplicado no build seguinte: o que foi escolhido no menuconfig e ficou está aqui.

# Correções: o sd-encrypt exige o dm-integrity ("module not found: 'dm_integrity'" no mkinitcpio), e o tkg
# desliga o SYSFB_SIMPLEFB (prepare: _disable "SYSFB_SIMPLEFB"), o que deixa o simpledrm sem framebuffer e o
# prompt do LUKS invisível. O fragmento é aplicado depois dos ajustes do tkg e os desfaz.
CONFIG_DM_INTEGRITY=m
CONFIG_SYSFB_SIMPLEFB=y

# TCP: o padrão precisa ser embutido. Westwood+, Vegas, YeAH e BBR ficam como módulos, carregados ao serem
# escolhidos em net.ipv4.tcp_congestion_control.
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_CUBIC=y
CONFIG_TCP_CONG_WESTWOOD=m
CONFIG_TCP_CONG_VEGAS=m
CONFIG_TCP_CONG_YEAH=m
CONFIG_TCP_CONG_BBR=m

# Compilado só para esta CPU (-march=native). O kernel deixa de bootar em outra máquina, o que aqui é intencional (§0).
CONFIG_X86_NATIVE_CPU=y

# Watchdog de suspend/resume: avisa aos 60 s e dá panic aos 120 s (gravado no pstore) se um driver travar o
# suspend ou o resume, o tipo de falha do travamento de 2026-11-10 (§32A.16).
CONFIG_DPM_WATCHDOG=y
CONFIG_DPM_WATCHDOG_TIMEOUT=120
CONFIG_DPM_WATCHDOG_WARNING_TIMEOUT=60

# Leitura e escrita no EC por /sys/kernel/debug/ec: ligado no menuconfig do 1º build e retirado em seguida. O
# Kconfig avisa que escrever valores errados pode confundir o EC a ponto de exigir tirar a bateria.
# CONFIG_ACPI_EC_DEBUGFS is not set

# THP só para quem pede com madvise (decisão do 1º build; antes "always")
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# HVO ligado por padrão nas páginas HugeTLB (as VMs com hugepages, §16)
CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP_DEFAULT_ON=y

# EDID embutido no firmware de vídeo, usado se o monitor não informar o seu
CONFIG_FIRMWARE_EDID=y

# SOF: o controlador de áudio do RPL-S (8086:7a50) está na lista do pci-tgl.c, habilitada pelo ALDERLAKE
# CONFIG_SND_SOC_SOF_TIGERLAKE is not set
CONFIG_SND_SOC_SOF_ALDERLAKE=m

# USB: impressora local (a de casa é de rede, §8). O USB_STORAGE_DEBUG, ligado no menuconfig, saiu: grava no
# journal uma mensagem por comando enviado ao pendrive, sem como desligar (drivers/usb/storage/debug.c).
CONFIG_USB_PRINTER=m
# CONFIG_USB_STORAGE_DEBUG is not set

# Gatilhos de LED: sem MTD aqui; o de CPU acende LEDs por atividade de cada núcleo e não há LED para isso
# CONFIG_LEDS_TRIGGER_MTD is not set
# CONFIG_LEDS_TRIGGER_CPU is not set
CONFIG_LEDS_TRIGGER_CAMERA=m

# Verificação da API de bitmap do Rust ("If unsure, say N", mas escolhido pelo usuário; custo só no código Rust)
CONFIG_RUST_BITMAP_HARDENED=y

# Autotestes dos algoritmos do crypto API no registro (o Kconfig cita bloquear drivers com bugs); sem o FULL
CONFIG_CRYPTO_SELFTESTS=y
# CONFIG_CRYPTO_SELFTESTS_FULL is not set
# Aceleradores de criptografia (QAT, CCP, VIA Padlock e afins): não existem aqui. O AES-NI e o SHA-NI da CPU
# ficam em "Accelerated Cryptographic Algorithms for CPU" e não dependem disto.
# CONFIG_CRYPTO_HW is not set

# Detector de vazamentos de memória do kernel compilado e desligado: liga com kmemleak=on na linha de comando
# e se lê em /sys/kernel/debug/kmemleak. Ligado sempre, rastreia toda alocação.
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_DEFAULT_OFF=y
CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN=y
# Autoteste do NMI no boot, uma vez ("If unsure, say N", mas escolhido pelo usuário; custo só no boot)
CONFIG_DEBUG_NMI_SELFTEST=y

# Crashlog da CPU (firmware: Cpu CrashLog ligado, 2026-11-12): registro do estado da CPU num erro grave de
# hardware, que sobrevive ao reboot e complementa o pstore (§32A.16). Lido em /sys/class/intel_pmt/crashlog*.
# O localmodconfig o tirava porque o dispositivo estava desligado no firmware.
CONFIG_INTEL_PMT_CRASHLOG=m

# Menus de fabricantes de Ethernet e Wi-Fi: só escondem perguntas, mas ficavam ligados (o localmodconfig já tira
# os drivers). Ficam o Realtek (r8169) e o Intel do Wi-Fi (iwlwifi).
# CONFIG_NET_VENDOR_3COM is not set
# CONFIG_NET_VENDOR_ADAPTEC is not set
# CONFIG_NET_VENDOR_AGERE is not set
# CONFIG_NET_VENDOR_ALACRITECH is not set
# CONFIG_NET_VENDOR_ALIBABA is not set
# CONFIG_NET_VENDOR_AMAZON is not set
# CONFIG_NET_VENDOR_AMD is not set
# CONFIG_NET_VENDOR_AQUANTIA is not set
# CONFIG_NET_VENDOR_ARC is not set
# CONFIG_NET_VENDOR_ASIX is not set
# CONFIG_NET_VENDOR_ATHEROS is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_CADENCE is not set
# CONFIG_NET_VENDOR_CAVIUM is not set
# CONFIG_NET_VENDOR_CHELSIO is not set
# CONFIG_NET_VENDOR_CISCO is not set
# CONFIG_NET_VENDOR_CORTINA is not set
# CONFIG_NET_VENDOR_DAVICOM is not set
# CONFIG_NET_VENDOR_DEC is not set
# CONFIG_NET_VENDOR_DLINK is not set
# CONFIG_NET_VENDOR_EMULEX is not set
