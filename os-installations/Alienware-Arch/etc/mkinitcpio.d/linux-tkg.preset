# mkinitcpio preset for linux-tkg: a UKI only, with no initramfs image and no
# fallback (systemd-boot finds the UKI by itself).
# Create it before installing the package, or the install hook creates one
# from the template, which builds an initramfs instead of a UKI.
## https://wiki.archlinux.org/title/Unified_kernel_image#.preset_file

ALL_kver="/boot/vmlinuz-linux-tkg"

PRESETS=('default')

default_uki="/boot/EFI/Linux/arch-linux-tkg.efi"
default_options="--splash /usr/share/systemd/bootctl/splash-arch.bmp"