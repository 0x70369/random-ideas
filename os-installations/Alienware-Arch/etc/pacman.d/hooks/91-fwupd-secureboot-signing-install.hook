[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = fwupd-efi

[Action]
Description = Signing fwupd's EFI capsule loader for Secure Boot...
When = PostTransaction
Exec = /usr/local/sbin/sbsign-mok.sh /usr/lib/fwupd/efi/fwupdx64.efi /usr/lib/fwupd/efi/fwupdx64.efi.signed
Depends = sbsigntools